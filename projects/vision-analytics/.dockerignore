# Build context for all images is the project root. Send the daemon only what the
# Dockerfiles COPY: ml-service code, models/, training/reports/, server/ and client/ sources.
**
!ml-service/requirements.txt
!ml-service/app/**
!ml-service/inference/**
!models/**
!training/reports/**
!server/package.json
!server/package-lock.json
!server/src/**
!client/package.json
!client/package-lock.json
!client/index.html
!client/vite.config.js
!client/src/**
**/__pycache__
**/node_modules
